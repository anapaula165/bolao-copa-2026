# Conexão do PostgreSQL (Neon, Supabase, Render ou local).
# Ex. Neon:   postgresql://usuario:senha@ep-xxx.neon.tech/neondb?sslmode=require
# Ex. local:  postgresql://postgres:postgres@localhost:5432/bolao
DATABASE_URL=

# Segredo para assinar os logins (use uma frase longa e aleatória).
JWT_SECRET=troque-isto-por-uma-frase-bem-longa-e-aleatoria

# E-mail que será o ADMINISTRADOR. Quem criar conta com este e-mail vira admin.
ADMIN_EMAIL=seu-email@empresa.com

# Prazo padrão dos palpites (horário de Brasília). Você também muda pelo painel admin.
DEADLINE=2026-06-11T12:00

# Porta local (o Render define a dele automaticamente).
PORT=3001

# ---- E-mail (opcional) para o "Esqueci minha senha" enviar o link automaticamente ----
# Se você NÃO preencher, o recurso continua funcionando: o admin gera o link
# na aba "Participantes" e envia para a pessoa (e o link também aparece no log do servidor).
# Para Gmail: crie uma "senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bolão da Copa <seu-email@gmail.com>

# Endereço público do site (usado para montar o link de redefinição no e-mail).
# Em produção, ex.: https://bolao-ibba.onrender.com  (sem barra no final)
APP_URL=
